@page "/liquidity"
@rendermode InteractiveServer
@inject DexApiClient Dex

<PageTitle>Liquidity · AspireDEX</PageTitle>

<h1>Liquidity</h1>
<p class="text-muted">
    Adding liquidity for a token pair that has no pool yet will have the Router create one
    automatically via the Factory on the first deposit.
</p>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Add liquidity</div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label">Token A</label>
                    <input class="form-control" @bind="_tokenA" placeholder="0x..." />
                </div>
                <div class="mb-2">
                    <label class="form-label">Token B</label>
                    <input class="form-control" @bind="_tokenB" placeholder="0x..." />
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <label class="form-label">Amount A</label>
                        <input class="form-control" @bind="_amountA" placeholder="1.0" />
                    </div>
                    <div class="col">
                        <label class="form-label">Amount B</label>
                        <input class="form-control" @bind="_amountB" placeholder="1.0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Max slippage on minimums (%)</label>
                    <input class="form-control" @bind="_slippagePercent" style="max-width: 120px;" />
                </div>
                <button class="btn btn-primary" @onclick="AddLiquidityAsync" disabled="@_busy">
                    Add liquidity
                </button>

                @if (_addTxHash is not null)
                {
                    <div class="alert alert-success mt-3 mb-0">Tx sent: <code>@_addTxHash</code></div>
                }
                @if (_addError is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@_addError</div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Remove liquidity</div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label">Token A</label>
                    <input class="form-control" @bind="_removeTokenA" placeholder="0x..." />
                </div>
                <div class="mb-2">
                    <label class="form-label">Token B</label>
                    <input class="form-control" @bind="_removeTokenB" placeholder="0x..." />
                </div>
                <div class="mb-3">
                    <label class="form-label">LP tokens to burn (wei)</label>
                    <input class="form-control" @bind="_liquidityWei" placeholder="1000000000000000000" />
                </div>
                <button class="btn btn-outline-danger" @onclick="RemoveLiquidityAsync" disabled="@_busy">
                    Remove liquidity
                </button>

                @if (_removeTxHash is not null)
                {
                    <div class="alert alert-success mt-3 mb-0">Tx sent: <code>@_removeTxHash</code></div>
                }
                @if (_removeError is not null)
                {
                    <div class="alert alert-danger mt-3 mb-0">@_removeError</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _tokenA = "";
    private string _tokenB = "";
    private string _amountA = "1.0";
    private string _amountB = "1.0";
    private decimal _slippagePercent = 1.0m;
    private string? _addTxHash;
    private string? _addError;

    private string _removeTokenA = "";
    private string _removeTokenB = "";
    private string _liquidityWei = "";
    private string? _removeTxHash;
    private string? _removeError;

    private bool _busy;

    private async Task AddLiquidityAsync()
    {
        _addError = null;
        _addTxHash = null;
        _busy = true;
        try
        {
            var amountAWei = ToWei(_amountA);
            var amountBWei = ToWei(_amountB);
            var minA = ApplySlippage(amountAWei, _slippagePercent);
            var minB = ApplySlippage(amountBWei, _slippagePercent);
            var deadline = DateTimeOffset.UtcNow.AddMinutes(10).ToUnixTimeSeconds();

            var request = new AddLiquidityRequestDto(
                _tokenA, _tokenB,
                amountAWei.ToString(), amountBWei.ToString(),
                minA.ToString(), minB.ToString(),
                _tokenA, // demo: LP tokens minted back to the operator account
                deadline);

            var result = await Dex.AddLiquidityAsync(request);
            _addTxHash = result.TransactionHash;
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveLiquidityAsync()
    {
        _removeError = null;
        _removeTxHash = null;
        _busy = true;
        try
        {
            if (!BigInteger.TryParse(_liquidityWei, out var liquidity))
            {
                _removeError = "Enter the LP amount in wei (an integer).";
                return;
            }

            var deadline = DateTimeOffset.UtcNow.AddMinutes(10).ToUnixTimeSeconds();
            var request = new RemoveLiquidityRequestDto(
                _removeTokenA, _removeTokenB,
                liquidity.ToString(),
                "0", "0", // demo: no minimum-out protection on removal; set real minimums in production
                _removeTokenA,
                deadline);

            var result = await Dex.RemoveLiquidityAsync(request);
            _removeTxHash = result.TransactionHash;
        }
        catch (Exception ex)
        {
            _removeError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static BigInteger ToWei(string humanAmount, int decimals = 18)
    {
        if (!decimal.TryParse(humanAmount, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            throw new ArgumentException($"'{humanAmount}' is not a valid decimal amount.");
        }

        var scaled = value * (decimal)BigInteger.Pow(10, decimals);
        return new BigInteger(scaled);
    }

    private static BigInteger ApplySlippage(BigInteger amount, decimal slippagePercent)
    {
        var keepBps = (int)Math.Round((100 - slippagePercent) * 100);
        return amount * keepBps / 10_000;
    }
}
